NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://admin:password@localhost:5433/college_prep_db?sslmode=disable

PGHOST=localhost
PGPORT=5433
PGUSER=admin
PGPASSWORD=password
PGDATABASE=college_prep_db
PGSSLMODE=disable

DB_SSL=false
DB_UUID_EXTENSION=pgcrypto
DB_AUTO_CREATE=true
DB_AUTO_CREATE_EXTENSION=true


JWT_SECRET=dev-secret
JWT_EXPIRATION=3600s

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MCQ_IMPORT_API_KEY=change-this

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SUPER_ADMIN_USERS=[]
CODE_EXECUTION_ENABLED=false

COMMUNICATION_SERVICES_CONNECTION_STRING=
COMMUNICATION_SERVICES_SENDER=DoNotReply@emble.in
