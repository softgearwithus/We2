NODE_ENV=production
PORT=3001
FRONTEND_URL=https://www.example.com

# Use one of the following patterns:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

DB_SSL=true
DB_UUID_EXTENSION=pgcrypto
DB_AUTO_CREATE=false
DB_AUTO_CREATE_EXTENSION=false


JWT_SECRET=
JWT_EXPIRATION=3600s

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MCQ_IMPORT_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SUPER_ADMIN_USERS=[]
CODE_EXECUTION_ENABLED=false

COMMUNICATION_SERVICES_CONNECTION_STRING=
COMMUNICATION_SERVICES_SENDER=DoNotReply@emble.in
